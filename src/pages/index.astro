---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { siteConfig } from '../data/siteConfig';

import headshot from '../assets/headshot.jpg';

const websiteSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://www.abohlegal.ca/#website",
  "name": "ABOH LEGAL",
  "url": "https://www.abohlegal.ca",
  "publisher": { "@id": "https://www.abohlegal.ca/#organization" }
});

const now = new Date();
const latestPosts = (await getCollection('blog', ({ data }) => !data.draft && (data.publishDate ?? data.date) <= now))
  .sort((a, b) => (b.data.publishDate ?? b.data.date).valueOf() - (a.data.publishDate ?? a.data.date).valueOf())
  .slice(0, 3);

const coreAreas = [
  { name: 'Family Law', href: '/services/family-law', desc: 'Divorce, parenting, support, property, and protection orders. Legal Aid accepted.' },
  { name: 'Child Protection', href: '/services/family-law', desc: 'When child welfare workers are involved with your family.' },
  { name: 'Estate Litigation', href: '/services/estate-litigation', desc: "Will challenges, dependants' relief claims, and executor disputes." },
  { name: 'Wills & Estates', href: '/services/wills-estates', desc: 'Wills, powers of attorney, and personal directives.' },
];
const otherAreas = [
  { name: 'Immigration', href: '/services/immigration', desc: 'Permanent residence, sponsorship, and permits. Clients inside and outside Canada.' },
  { name: 'Employment Law', href: '/services/employment-law', desc: 'Wrongful dismissal, severance, and workplace disputes.' },
  { name: 'Business & Commercial', href: '/services/business-commercial', desc: 'Incorporations, shareholder agreements, contracts, and leases.' },
  { name: 'Civil Litigation', href: '/services/civil-litigation', desc: 'Contract, debt, and negligence claims.' },
];

const steps = [
  { title: 'Call or book online', body: "Give us your name, the type of legal problem, and the other party's name." },
  { title: 'We check for conflicts', body: 'We make sure we do not already act for the other side.' },
  { title: 'We meet and make a plan', body: 'By phone, by video, or at our office. We explain your options in plain language.' },
];

const fmt = (d: Date) => d.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<BaseLayout
  title="ABOH LEGAL | Family Law, Estates & More | St. Paul, Alberta"
  description="Law firm in St. Paul, Alberta, for family law, wills and estates, estate disputes, employment, business, civil litigation, and immigration. Legal Aid accepted for family cases."
>
  <script slot="head" type="application/ld+json" set:html={websiteSchema} />

  <!-- HERO: headline left, Prince right -->
  <section class="bg-navy px-6 text-white">
    <div class="mx-auto grid max-w-6xl items-center gap-12 py-14 md:grid-cols-2 md:gap-16 md:py-20">
      <div class="text-center md:text-left">
        <p class="text-xs font-bold uppercase tracking-[0.3em] text-gold-bright">St. Paul, Alberta</p>
        <h1 class="mt-4 font-heading text-4xl font-bold leading-tight text-white md:text-5xl lg:text-6xl">
          Clear legal advice.<br />
          <span class="text-gold-bright">Across Alberta.</span>
        </h1>
        <p class="mt-5 text-lg text-white/85 md:text-xl">
          Family law, child protection, wills, and estate disputes. Legal Aid accepted for family cases.
        </p>
        <div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row md:justify-start">
          <a href={siteConfig.bookingUrl} target="_blank" rel="noopener noreferrer"
             class="rounded bg-gold px-8 py-3 text-center text-sm font-bold uppercase tracking-wider text-navy transition-colors hover:bg-[#d4aa5a]">
            Book a Time
          </a>
          <a href={siteConfig.phoneHref}
             class="rounded border-2 border-white px-8 py-3 text-center text-sm font-bold uppercase tracking-wider text-white transition-colors hover:bg-white/10">
            Call {siteConfig.phone}
          </a>
        </div>
        <p class="mt-6 text-sm text-white/70">Serving St. Paul, Bonnyville, Cold Lake, Vermilion, Lloydminster, Lac La Biche, Fort Saskatchewan, and Edmonton.</p>
      </div>
      <div class="mx-auto w-full max-w-xs md:max-w-sm">
        <Image
          src={headshot}
          alt="Prince Aboh, lawyer, ABOH LEGAL"
          class="mx-auto h-auto w-full rounded-lg border-b-4 border-gold shadow-xl"
          widths={[320, 640, 900]}
          sizes="(max-width: 768px) 320px, 40vw"
          format="webp"
          quality={82}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <section class="bg-gold px-6 py-3">
    <div class="mx-auto flex max-w-7xl flex-col items-center justify-center gap-2 sm:flex-row sm:gap-8">
      <span class="whitespace-nowrap text-sm font-bold text-navy">&#10003; Legal Aid for Family Cases</span>
      <span class="whitespace-nowrap text-sm font-bold text-navy">&#10003; Clients Across Alberta</span>
      <span class="whitespace-nowrap text-sm font-bold text-navy">&#10003; Meet by Phone, Video, or In Person</span>
    </div>
  </section>

  <!-- INTRO -->
  <section class="bg-white px-6 py-16 md:py-20">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="font-heading text-3xl font-bold text-navy md:text-4xl">Prince Aboh, Barrister and Solicitor</h2>
      <p class="mt-5 text-base leading-relaxed text-body-text md:text-lg">
        Prince is a member of the Law Society of Alberta and practises from St. Paul. His work is mainly family law, child protection, and estate disputes, in the Court of King&rsquo;s Bench and the Alberta Court of Justice across northeastern Alberta. He handles each file himself.
      </p>
      <a href="/about" class="mt-6 inline-block font-bold text-gold underline hover:no-underline">More about Prince</a>
    </div>
  </section>

  <!-- PRACTICE AREAS -->
  <section class="bg-light-bg px-6 py-16 md:py-20">
    <div class="mx-auto max-w-7xl">
      <h2 class="text-center font-heading text-3xl font-bold text-navy md:text-4xl">How We Can Help</h2>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {coreAreas.map((a) => (
          <a href={a.href} class="group flex flex-col rounded-lg border-t-4 border-gold bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
            <h3 class="font-heading text-xl font-bold text-navy group-hover:text-gold">{a.name}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-body-text">{a.desc}</p>
            <span class="mt-4 text-sm font-bold text-gold">Learn more &rarr;</span>
          </a>
        ))}
      </div>
      <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {otherAreas.map((a) => (
          <a href={a.href} class="group flex flex-col rounded-lg border-t-4 border-gray-300 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-gold hover:shadow-md">
            <h3 class="font-heading text-xl font-bold text-navy group-hover:text-gold">{a.name}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-body-text">{a.desc}</p>
            <span class="mt-4 text-sm font-bold text-gold">Learn more &rarr;</span>
          </a>
        ))}
      </div>
      <div class="mt-8 flex flex-col items-center justify-between gap-4 rounded-lg bg-navy px-7 py-6 text-center md:flex-row md:text-left">
        <div>
          <p class="font-heading text-xl font-bold text-white">Not sure which area fits?</p>
          <p class="mt-1 text-white/80">Tell us about your legal problem in a few words. We will tell you if we can help.</p>
        </div>
        <div class="flex shrink-0 gap-3">
          <a href={siteConfig.phoneHref} class="rounded border-2 border-white px-5 py-2.5 text-sm font-bold uppercase tracking-wider text-white hover:bg-white/10">Call</a>
          <a href={siteConfig.bookingUrl} target="_blank" rel="noopener noreferrer" class="rounded bg-gold px-5 py-2.5 text-sm font-bold uppercase tracking-wider text-navy hover:brightness-110">Book a Time</a>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="bg-white px-6 py-16 md:py-20">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-center font-heading text-3xl font-bold text-navy md:text-4xl">How It Works</h2>
      <ol class="mt-10 grid gap-8 md:grid-cols-3">
        {steps.map((s, i) => (
          <li class="text-center">
            <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-navy font-heading text-xl font-bold text-white">{i + 1}</span>
            <h3 class="mt-4 font-heading text-xl font-bold text-navy">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-body-text">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- LATEST ARTICLES -->
  {latestPosts.length > 0 && (
    <section class="bg-light-bg px-6 py-16 md:py-20">
      <div class="mx-auto max-w-7xl">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 class="font-heading text-3xl font-bold text-navy md:text-4xl">Plain-English Legal Guides</h2>
          <a href="/resources" class="font-bold text-gold underline hover:no-underline">All articles</a>
        </div>
        <div class="mt-8 grid gap-6 md:grid-cols-3">
          {latestPosts.map((post) => (
            <BlogCard
              title={post.data.title}
              date={fmt(post.data.publishDate ?? post.data.date)}
              category={post.data.category}
              excerpt={post.data.excerpt}
              slug={post.id}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CLOSING CALL TO ACTION -->
  <section class="bg-navy px-6 py-16 text-center md:py-20">
    <h2 class="font-heading text-3xl font-bold text-white md:text-4xl">Have a legal problem?</h2>
    <p class="mt-4 text-lg text-white/80">Call <a href={siteConfig.phoneHref} class="font-bold text-white underline">{siteConfig.phone}</a> or book a time online.</p>
    <div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row">
      <a href={siteConfig.bookingUrl} target="_blank" rel="noopener noreferrer"
         class="rounded bg-gold px-10 py-4 text-sm font-bold uppercase tracking-wider text-navy transition hover:brightness-110">
        Book a Time
      </a>
      <a href={siteConfig.phoneHref}
         class="rounded border-2 border-white px-10 py-4 text-sm font-bold uppercase tracking-wider text-white transition hover:bg-white/10">
        Call Now
      </a>
    </div>
  </section>
</BaseLayout>
