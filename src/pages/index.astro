---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image, getImage } from 'astro:assets';
import { services } from '../data/services';

import courthouseColumns from '../assets/stock/courthouse-columns.jpg';
import familyGoldenField from '../assets/stock/family-golden-field.jpg';
import documentSigning from '../assets/stock/document-signing.jpg';
import businessMeetingOverhead from '../assets/stock/business-meeting-overhead.jpg';
import canadianPassports from '../assets/stock/canadian-passports.jpg';
import prairieRoad from '../assets/stock/prairie-road.jpg';
import conferenceRoom from '../assets/stock/conference-room.jpg';

const prairieRoadOptimized = await getImage({ src: prairieRoad, format: 'webp', quality: 80, width: 1920 });

const websiteSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://www.abohlegal.ca/#website",
  "name": "ABOH LEGAL",
  "url": "https://www.abohlegal.ca",
  "publisher": { "@id": "https://www.abohlegal.ca/#organization" }
});
---

<BaseLayout
  title="ABOH LEGAL | Family Law, Estates & More | St. Paul, Alberta"
  description="Law firm in St. Paul, Alberta, for family law, wills and estates, estate disputes, employment, business, civil litigation, and immigration. Legal Aid certificates accepted."
>
  <script slot="head" type="application/ld+json" set:html={websiteSchema} />

  <!-- HERO: Full-width courthouse columns with text overlay -->
  <section class="relative min-h-[550px] md:min-h-[600px] flex items-center px-6 overflow-hidden">
    <Image
      src={courthouseColumns}
      alt="Courthouse columns representing legal services"
      class="absolute inset-0 w-full h-full object-cover object-center"
      aria-hidden="true"
      widths={[640, 960, 1920]}
      sizes="100vw"
      format="webp"
      quality={80}
      loading="eager"
      fetchpriority="high"
    />
    <!-- Mobile: darker full overlay -->
    <div class="absolute inset-0 bg-navy/85 md:hidden"></div>
    <!-- Desktop: left-to-right gradient -->
    <div class="absolute inset-0 hidden md:block bg-gradient-to-r from-navy/90 via-navy/70 to-navy/40"></div>

    <div class="relative max-w-7xl mx-auto w-full py-16 md:py-24">
      <div class="max-w-2xl md:text-left text-center mx-auto md:mx-0">
        <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6">
          <span class="text-white">Clear advice.</span><br />
          <span class="text-white">Steady advocacy.</span><br />
          <span class="text-gold-bright">Alberta-wide.</span>
        </h1>
        <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start mt-8">
          <a
            href="/contact"
            class="inline-block bg-gold text-navy font-bold px-8 py-3 rounded text-center hover:bg-[#d4aa5a] transition-colors text-sm uppercase tracking-wider"
          >
            Schedule a Consultation
          </a>
          <a
            href="tel:+18254610107"
            class="inline-block border-2 border-white text-white font-bold px-8 py-3 rounded text-center hover:bg-white/10 transition-colors text-sm uppercase tracking-wider"
          >
            &#9742; (825) 461-0107
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <section class="bg-gold py-4 px-6">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-8">
      <span class="text-navy font-bold text-sm md:text-base whitespace-nowrap">&#10003; Legal Aid Clients Welcome</span>
      <span class="text-navy font-bold text-sm md:text-base whitespace-nowrap">&#10003; Clients Across Alberta</span>
      <span class="text-navy font-bold text-sm md:text-base whitespace-nowrap">&#10003; Meet by Phone, Video, or In Person</span>
    </div>
  </section>

  <!-- FIRM INTRO (SEO content block) -->
  <section class="bg-white py-14 md:py-18 px-6">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-body-text text-base md:text-lg leading-relaxed">
        ABOH LEGAL is a law firm in St. Paul, Alberta. We act for clients in the Court of King's Bench and the Alberta Court of Justice, in St. Paul and across the region, including Bonnyville, Cold Lake, Vermilion, Lloydminster, Fort Saskatchewan, Lac La Biche, and Edmonton.
      </p>
    </div>
  </section>

  <!-- PRACTICE AREAS: Alternating half-page splits -->
  <section class="bg-white">
    <!-- Row 1: Text left, Image right -->
    <div class="flex flex-col lg:flex-row min-h-[500px]">
      <div class="lg:w-1/2 p-12 md:p-20 flex flex-col justify-center">
        <span class="text-gold text-sm md:text-xs font-bold tracking-[0.3em] mb-4 uppercase">Practice Areas</span>
        <h2 class="animate-on-scroll font-heading text-3xl md:text-4xl font-bold mb-12 tracking-tight">How We Can Help</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
          <a href="/services/family-law" class="space-y-3 group">
            <div class="w-8 h-[2px] bg-gold"></div>
            <h3 class="text-lg font-bold text-navy group-hover:text-gold transition-colors">Family Law</h3>
            <p class="text-body-text text-sm leading-relaxed text-left">Divorce, parenting and custody, child and spousal support, property division, and guardianship.</p>
          </a>
          <a href="/services/wills-estates" class="space-y-3 group">
            <div class="w-8 h-[2px] bg-gold"></div>
            <h3 class="text-lg font-bold text-navy group-hover:text-gold transition-colors">Wills & Estates</h3>
            <p class="text-body-text text-sm leading-relaxed text-left">Wills, powers of attorney, personal directives, and estate planning.</p>
          </a>
        </div>
      </div>
      <div class="lg:w-1/2 relative min-h-[400px] overflow-hidden group">
        <Image
          src={familyGoldenField}
          alt="Family looking toward the future"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
          widths={[640, 960, 1920]}
          sizes="(max-width: 1024px) 100vw, 50vw"
          format="webp"
          quality={80}
          loading="lazy"
        />
      </div>
    </div>

    <!-- Row 2: Image left, Text right -->
    <div class="flex flex-col lg:flex-row-reverse min-h-[500px]">
      <div class="lg:w-1/2 p-12 md:p-20 flex flex-col justify-center">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
          <a href="/services/estate-litigation" class="space-y-3 group">
            <div class="w-8 h-[2px] bg-gold"></div>
            <h3 class="text-lg font-bold text-navy group-hover:text-gold transition-colors">Estate Litigation</h3>
            <p class="text-body-text text-sm leading-relaxed text-left">Will challenges, dependants' relief claims, and other estate disputes.</p>
          </a>
          <a href="/services/employment-law" class="space-y-3 group">
            <div class="w-8 h-[2px] bg-gold"></div>
            <h3 class="text-lg font-bold text-navy group-hover:text-gold transition-colors">Employment Law</h3>
            <p class="text-body-text text-sm leading-relaxed text-left">Wrongful dismissal, severance, employment contracts, and workplace disputes.</p>
          </a>
        </div>
      </div>
      <div class="lg:w-1/2 relative min-h-[400px] overflow-hidden group">
        <Image
          src={documentSigning}
          alt="Legal document signing"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
          widths={[640, 960, 1920]}
          sizes="(max-width: 1024px) 100vw, 50vw"
          format="webp"
          quality={80}
          loading="lazy"
        />
      </div>
    </div>

    <!-- Row 3: Text left, Image right -->
    <div class="flex flex-col lg:flex-row min-h-[500px]">
      <div class="lg:w-1/2 p-12 md:p-20 flex flex-col justify-center">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
          <a href="/services/business-commercial" class="space-y-3 group">
            <div class="w-8 h-[2px] bg-gold"></div>
            <h3 class="text-lg font-bold text-navy group-hover:text-gold transition-colors">Business & Commercial</h3>
            <p class="text-body-text text-sm leading-relaxed text-left">Incorporations, shareholder agreements, commercial leases, and business contracts.</p>
          </a>
          <a href="/services/civil-litigation" class="space-y-3 group">
            <div class="w-8 h-[2px] bg-gold"></div>
            <h3 class="text-lg font-bold text-navy group-hover:text-gold transition-colors">Civil Litigation</h3>
            <p class="text-body-text text-sm leading-relaxed text-left">Contract disputes, debt recovery, property disputes, and negligence claims.</p>
          </a>
        </div>
      </div>
      <div class="lg:w-1/2 relative min-h-[400px] overflow-hidden group">
        <Image
          src={businessMeetingOverhead}
          alt="Business meeting overhead view"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
          widths={[640, 960, 1920]}
          sizes="(max-width: 1024px) 100vw, 50vw"
          format="webp"
          quality={80}
          loading="lazy"
        />
      </div>
    </div>

    <!-- Row 4: Image left, Text right -->
    <div class="flex flex-col lg:flex-row-reverse min-h-[500px]">
      <div class="lg:w-1/2 p-12 md:p-20 flex flex-col justify-center">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
          <a href="/contact" class="space-y-3 group">
            <div class="w-8 h-[2px] bg-gold"></div>
            <h3 class="text-lg font-bold text-navy group-hover:text-gold transition-colors">Not Sure Which Area Fits?</h3>
            <p class="text-body-text text-sm leading-relaxed text-left">Tell us about your legal problem in a few words. We will tell you if we can help.</p>
          </a>
          <a href="/services/immigration" class="space-y-3 group">
            <div class="w-8 h-[2px] bg-gold"></div>
            <h3 class="text-lg font-bold text-navy group-hover:text-gold transition-colors">Immigration</h3>
            <p class="text-body-text text-sm leading-relaxed text-left">Permanent residence, family sponsorship, work permits, and citizenship.</p>
          </a>
        </div>
      </div>
      <div class="lg:w-1/2 relative min-h-[400px] overflow-hidden group">
        <Image
          src={canadianPassports}
          alt="Canadian passports"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
          widths={[640, 960, 1920]}
          sizes="(max-width: 1024px) 100vw, 50vw"
          format="webp"
          quality={80}
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- FULL-WIDTH PARALLAX LANDSCAPE BREAK -->
  <section class="relative h-[500px] w-full overflow-hidden">
    <div
      class="absolute inset-0 bg-fixed bg-cover bg-center"
      style={`background-image: url('${prairieRoadOptimized.src}');`}
      aria-hidden="true"
    ></div>
    <div class="absolute inset-0 bg-navy/20"></div>
  </section>

  <!-- CTA with background image -->
  <section class="relative py-32 md:py-40 flex items-center justify-center overflow-hidden">
    <Image
      src={conferenceRoom}
      alt="Conference room"
      class="absolute inset-0 w-full h-full object-cover"
      aria-hidden="true"
      widths={[640, 960, 1920]}
      sizes="100vw"
      format="webp"
      quality={80}
      loading="lazy"
    />
    <div class="absolute inset-0 bg-navy/85"></div>
    <div class="relative z-10 max-w-[1200px] mx-auto px-8 text-center text-white">
      <h2 class="font-heading text-4xl md:text-5xl font-bold mb-8 tracking-tight">Have a legal problem?</h2>
      <p class="text-white/70 text-lg md:text-xl mb-12 max-w-2xl mx-auto font-light">
        Call +1 (825) 461-0107 or book a time online.
      </p>
      <a
        href="/contact"
        class="inline-block bg-gold text-navy px-12 py-5 text-sm font-bold tracking-[0.2em] uppercase hover:brightness-110 transition-all shadow-xl"
      >
        Book a Time
      </a>
    </div>
  </section>
</BaseLayout>
