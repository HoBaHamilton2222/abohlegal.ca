---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { serviceDetails } from '../../data/serviceDetails';
import documentSigning from '../../assets/stock/document-signing.jpg';

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.abohlegal.ca/" },
    { "@type": "ListItem", "position": 2, "name": "Services" }
  ]
});
---

<BaseLayout
  title="Legal Services | Family Law, Estates, Litigation | ABOH LEGAL St. Paul Alberta"
  description="Family law, wills and estates, estate disputes, employment, business, civil litigation, and immigration. A law firm in St. Paul, Alberta."
>
  <script slot="head" type="application/ld+json" set:html={breadcrumbSchema} />

  <Hero title="Legal Services" backgroundImage={documentSigning} />

  <section class="bg-white py-12 md:py-16 px-6">
    <div class="max-w-4xl mx-auto">
      <div class="text-body-text text-base md:text-lg leading-relaxed text-center mb-12 max-w-2xl mx-auto space-y-4">
        <p>
          ABOH LEGAL helps individuals, families, and businesses across Alberta.
        </p>
        <p>
          We accept Legal Aid Alberta certificates for family law cases, including protection order hearings. You can meet with us by phone, by video, or in person. We appear in court across northeastern Alberta, including in St. Paul, Bonnyville, Cold Lake, Vermilion, Lloydminster, and Wainwright.
        </p>
        <p>
          Choose a practice area below.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {serviceDetails.map((service) => (
          <ServiceCard
            name={service.name}
            slug={service.slug}
            description={service.shortDesc}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
