---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import headshot from '../assets/headshot.jpg';

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.abohlegal.ca/" },
    { "@type": "ListItem", "position": 2, "name": "About" }
  ]
});

const personSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://www.abohlegal.ca/about#person",
  "name": "Prince Aboh",
  "jobTitle": "Barrister & Solicitor",
  "url": "https://www.abohlegal.ca/about",
  "worksFor": { "@id": "https://www.abohlegal.ca/#organization" },
  "alumniOf": [
    { "@type": "EducationalOrganization", "name": "University of Maiduguri" },
    { "@type": "EducationalOrganization", "name": "Nigerian Law School" }
  ],
  "memberOf": [
    { "@type": "Organization", "name": "Law Society of Alberta" },
    { "@type": "Organization", "name": "Canadian Bar Association" },
    { "@type": "Organization", "name": "Association of Family and Conciliation Courts" },
    { "@type": "Organization", "name": "The Advocates' Society" }
  ],
  "knowsAbout": ["Family Law", "Child Protection", "Estate Litigation", "Wills and Estates", "Immigration Law", "Employment Law", "Business Law", "Civil Litigation"]
});
---

<BaseLayout
  title="About Prince Aboh | Family Lawyer St. Paul, Alberta | ABOH LEGAL"
  description="Prince Aboh is a lawyer in St. Paul, Alberta, called to the Alberta bar in 2024. Family law, estate litigation, and more."
>
  <script slot="head" type="application/ld+json" set:html={personSchema} />
  <script slot="head" type="application/ld+json" set:html={breadcrumbSchema} />

  <!-- Section 1: Portrait + Credentials side by side -->
  <section class="bg-white pt-16 md:pt-24 pb-10 md:pb-14 px-6">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-[320px_1fr] lg:grid-cols-[380px_1fr] gap-10 lg:gap-14 items-stretch">
      <!-- Portrait -->
      <div class="relative overflow-hidden rounded-lg mx-auto md:mx-0 max-w-[320px] md:max-w-none">
        <Image
          src={headshot}
          alt="Prince Aboh, Barrister and Solicitor"
          class="w-full h-full object-cover object-[center_15%] rounded-lg"
          widths={[380, 640]}
          sizes="(max-width: 768px) 320px, 380px"
          format="webp"
          quality={85}
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <!-- Name + Credentials -->
      <div class="flex flex-col justify-center">
        <h1 class="font-heading text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight leading-[1.1] text-navy mb-8">
          Prince Aboh<span class="font-normal text-muted-text text-base md:text-lg lg:text-xl ml-2 align-baseline">LL.B., B.L.</span>
        </h1>

        <dl class="divide-y divide-navy/10 border-t border-b border-navy/10">
          <div class="grid grid-cols-[110px_1fr] md:grid-cols-[140px_1fr] gap-4 py-4">
            <dt class="text-gold text-[11px] md:text-xs font-bold tracking-[0.25em] uppercase pt-0.5">Education</dt>
            <dd class="text-body-text text-sm leading-relaxed space-y-0.5">
              <div>LL.B., University of Maiduguri</div>
              <div>B.L., Nigerian Law School</div>
              <div>NCA Certificate of Qualification</div>
            </dd>
          </div>
          <div class="grid grid-cols-[110px_1fr] md:grid-cols-[140px_1fr] gap-4 py-4">
            <dt class="text-gold text-[11px] md:text-xs font-bold tracking-[0.25em] uppercase pt-0.5">Admissions</dt>
            <dd class="text-body-text text-sm leading-relaxed space-y-0.5">
              <div>Law Society of Alberta, 2024</div>
              <div>Nigerian Bar Association, 2014</div>
            </dd>
          </div>
          <div class="grid grid-cols-[110px_1fr] md:grid-cols-[140px_1fr] gap-4 py-4">
            <dt class="text-gold text-[11px] md:text-xs font-bold tracking-[0.25em] uppercase pt-0.5">Memberships</dt>
            <dd class="text-body-text text-sm leading-relaxed space-y-0.5">
              <div>Canadian Bar Association</div>
              <div>Association of Family and Conciliation Courts</div>
              <div>The Advocates' Society</div>
              <div>Calgary Region Immigrant Employment Council</div>
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Section 2: Profile -->
  <section class="bg-light-bg pt-12 md:pt-16 pb-10 md:pb-14 px-6">
    <div class="max-w-4xl mx-auto">
      <div class="space-y-10 text-body-text text-base md:text-lg leading-relaxed text-justify">
        <section class="space-y-4">
          <h2 class="font-heading text-navy text-lg md:text-xl font-bold tracking-tight">Practice</h2>
          <p>
            Prince is based in St. Paul and acts for clients across Alberta. His practice focuses on <a href="/services/family-law" class="text-gold underline hover:no-underline">family law</a>, including child protection, and <a href="/services/estate-litigation" class="text-gold underline hover:no-underline">estate litigation</a>. He also handles <a href="/services/immigration" class="text-gold underline hover:no-underline">immigration</a>, <a href="/services/employment-law" class="text-gold underline hover:no-underline">employment</a>, <a href="/services/business-commercial" class="text-gold underline hover:no-underline">business</a>, and <a href="/services/civil-litigation" class="text-gold underline hover:no-underline">civil litigation</a> matters.
          </p>
          <p>
            Prince moved to St. Paul with his family in 2025 and opened ABOH LEGAL to serve the Lakeland region of northeastern Alberta. He appears in court in St. Paul, Bonnyville, Cold Lake, Vermilion, Lloydminster, and Wainwright.
          </p>
        </section>

        <section class="space-y-4">
          <h2 class="font-heading text-navy text-lg md:text-xl font-bold tracking-tight">Background</h2>
          <p>
            Prince began his career in Lagos, Nigeria, as a commercial litigator. He then worked as in-house counsel (a company's own lawyer) in the energy, insurance, and non-profit sectors.
          </p>
          <p>
            In 2022 he received his Certificate of Qualification from the National Committee on Accreditation (NCA), which assesses lawyers trained outside Canada. In 2023 he articled (the training year for new lawyers) with a litigation firm in Calgary, working on medical negligence, <a href="/services/employment-law" class="text-gold underline hover:no-underline">employment</a>, and <a href="/services/civil-litigation" class="text-gold underline hover:no-underline">commercial</a> cases. He was called to the Alberta bar in 2024.
          </p>
        </section>

        <section class="space-y-4">
          <h2 class="font-heading text-navy text-lg md:text-xl font-bold tracking-tight">Community</h2>
          <p>
            In Calgary, Prince volunteered with the Elizabeth Fry Society, helping people find their way at the courthouse. He also volunteered with the Court of King's Bench Amicus Program, which helps people without lawyers in court. As a mentor with the Calgary Region Immigrant Employment Council, he helped newcomers settle into work in Canada.
          </p>
        </section>

        <section class="space-y-4">
          <h2 class="font-heading text-navy text-lg md:text-xl font-bold tracking-tight">Outside the Office</h2>
          <p>
            Away from work, Prince likes new tech gadgets and Hillsong worship music. Global politics and football will always start a conversation with him. He spends his free time hiking, gaming, and travelling.
          </p>
        </section>

        <div class="flex flex-col sm:flex-row gap-4 justify-center pt-4 text-center">
        <a
          href="/contact"
          class="inline-block bg-gold text-navy font-bold px-8 py-3 rounded hover:bg-[#d4aa5a] transition-colors text-sm uppercase tracking-wider"
        >
          Schedule a Consultation
        </a>
        <a
          href="tel:+18254610107"
          class="inline-block border-2 border-navy text-navy font-bold px-8 py-3 rounded hover:bg-navy/5 transition-colors text-sm uppercase tracking-wider"
        >
          &#9742; (825) 461-0107
        </a>
      </div>
      </div>
    </div>
  </section>

  <!-- Section 3: What to Expect -->
  <section class="bg-light-bg pt-10 md:pt-14 pb-20 md:pb-28 px-6">
    <div class="max-w-5xl mx-auto">
      <h2 class="font-heading text-navy text-2xl md:text-3xl font-bold text-center mb-14 tracking-tight">
        What to Expect
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
        <div class="space-y-4">
          <div class="w-10 h-0.5 bg-gold"></div>
          <h3 class="font-heading text-navy text-lg font-bold">We Work Together</h3>
          <p class="text-body-text leading-relaxed">
            Prince handles your file himself. He will explain your options and agree on a plan with you before he acts.
          </p>
        </div>
        <div class="space-y-4">
          <div class="w-10 h-0.5 bg-gold"></div>
          <h3 class="font-heading text-navy text-lg font-bold">Clear and Honest</h3>
          <p class="text-body-text leading-relaxed">
            Ask any question you have. Prince will tell you plainly where your case stands and what your options are.
          </p>
        </div>
        <div class="space-y-4">
          <div class="w-10 h-0.5 bg-gold"></div>
          <h3 class="font-heading text-navy text-lg font-bold">Careful Preparation</h3>
          <p class="text-body-text leading-relaxed">
            Before each step, Prince tells you the risks and what to expect.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
