---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import headshot from '../assets/headshot.jpg';

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.abohlegal.ca/" },
    { "@type": "ListItem", "position": 2, "name": "About" }
  ]
});

const personSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://www.abohlegal.ca/about#person",
  "name": "Prince Aboh",
  "jobTitle": "Barrister & Solicitor",
  "url": "https://www.abohlegal.ca/about",
  "worksFor": { "@id": "https://www.abohlegal.ca/#organization" },
  "alumniOf": [
    { "@type": "EducationalOrganization", "name": "University of Maiduguri" },
    { "@type": "EducationalOrganization", "name": "Nigerian Law School" }
  ],
  "memberOf": [
    { "@type": "Organization", "name": "Law Society of Alberta" },
    { "@type": "Organization", "name": "Canadian Bar Association" },
    { "@type": "Organization", "name": "Association of Family and Conciliation Courts" },
    { "@type": "Organization", "name": "The Advocates' Society" }
  ],
  "knowsAbout": ["Family Law", "Immigration Law", "Employment Law", "Civil Litigation", "Wills and Estates", "Estate Litigation"]
});
---

<BaseLayout
  title="About Prince Aboh | Family Lawyer St. Paul, Alberta | ABOH LEGAL"
  description="Meet Prince Aboh, a litigator and solicitor serving Alberta from St. Paul. Trained in Nigeria, licensed in Alberta, committed to your community."
>
  <script slot="head" type="application/ld+json" set:html={personSchema} />
  <script slot="head" type="application/ld+json" set:html={breadcrumbSchema} />

  <!-- Section 1: Portrait + Credentials side by side -->
  <section class="bg-white pt-16 md:pt-24 pb-10 md:pb-14 px-6">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-[320px_1fr] lg:grid-cols-[380px_1fr] gap-10 lg:gap-14 items-stretch">
      <!-- Portrait -->
      <div class="relative overflow-hidden rounded-lg mx-auto md:mx-0 max-w-[320px] md:max-w-none">
        <Image
          src={headshot}
          alt="Prince Aboh, Barrister and Solicitor"
          class="w-full h-full object-cover object-[center_15%] rounded-lg"
          widths={[380, 640]}
          sizes="(max-width: 768px) 320px, 380px"
          format="webp"
          quality={85}
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <!-- Name + Credentials -->
      <div class="flex flex-col justify-center">
        <h1 class="font-heading text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight leading-[1.1] text-navy mb-8">
          Prince Aboh<span class="font-normal text-navy/55 text-base md:text-lg lg:text-xl ml-2 align-baseline">LL.B., B.L.</span>
        </h1>

        <dl class="divide-y divide-navy/10 border-t border-b border-navy/10">
          <div class="grid grid-cols-[110px_1fr] md:grid-cols-[140px_1fr] gap-4 py-4">
            <dt class="text-gold text-[11px] md:text-xs font-bold tracking-[0.25em] uppercase pt-0.5">Education</dt>
            <dd class="text-body-text text-sm leading-relaxed space-y-0.5">
              <div>LL.B., University of Maiduguri</div>
              <div>B.L., Nigerian Law School</div>
              <div>NCA Certificate of Qualification</div>
            </dd>
          </div>
          <div class="grid grid-cols-[110px_1fr] md:grid-cols-[140px_1fr] gap-4 py-4">
            <dt class="text-gold text-[11px] md:text-xs font-bold tracking-[0.25em] uppercase pt-0.5">Admissions</dt>
            <dd class="text-body-text text-sm leading-relaxed space-y-0.5">
              <div>Law Society of Alberta, 2024</div>
              <div>Nigerian Bar Association, 2014</div>
            </dd>
          </div>
          <div class="grid grid-cols-[110px_1fr] md:grid-cols-[140px_1fr] gap-4 py-4">
            <dt class="text-gold text-[11px] md:text-xs font-bold tracking-[0.25em] uppercase pt-0.5">Memberships</dt>
            <dd class="text-body-text text-sm leading-relaxed space-y-0.5">
              <div>Canadian Bar Association</div>
              <div>Association of Family and Conciliation Courts</div>
              <div>The Advocates' Society</div>
              <div>Calgary Region Immigrant Employment Council</div>
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Section 2: Profile -->
  <section class="bg-light-bg pt-12 md:pt-16 pb-10 md:pb-14 px-6">
    <div class="max-w-4xl mx-auto">
      <div class="space-y-10 text-body-text text-base md:text-lg leading-relaxed text-justify">
        <section class="space-y-4">
          <h3 class="font-heading text-navy text-lg md:text-xl font-bold tracking-tight">Practice</h3>
          <p>
            Prince serves individuals and families across Alberta from his base in St. Paul. His practice focuses on <a href="/services/family-law" class="text-gold hover:underline">family law</a>, <a href="/services/immigration" class="text-gold hover:underline">immigration law</a>, <a href="/services/employment-law" class="text-gold hover:underline">employment law</a>, and general litigation. He combines foreign legal training with Canadian legal experience to help clients navigate high-stakes decisions with clarity.
          </p>
          <p>
            In 2025, Prince relocated with his family to St. Paul, drawn by its welcoming community. He established ABOH LEGAL to provide accessible legal services across the Lakeland region. He appears regularly before the Court of King's Bench and the Alberta Court of Justice at the St. Paul, Vermilion, Lloydminster, Cold Lake, Wainwright and Bonnyville court locations.
          </p>
        </section>

        <section class="space-y-4">
          <h3 class="font-heading text-navy text-lg md:text-xl font-bold tracking-tight">Background</h3>
          <p>
            Prince began his legal career in Lagos, Nigeria, where he practised commercial litigation before moving into in-house counsel roles across the energy, insurance, and non-profit sectors. That early breadth of exposure gave him a perspective he carries into every file.
          </p>
          <p>
            After immigrating to Canada, Prince completed his Canadian legal qualifications through the NCA in 2022 before commencing articles with a respected boutique litigation firm in Calgary in 2023, gaining further practice exposure in medical negligence work, <a href="/services/employment-law" class="text-gold hover:underline">employment law</a>, and <a href="/services/civil-litigation" class="text-gold hover:underline">commercial litigation</a>. He was called to the Alberta bar in 2024.
          </p>
        </section>

        <section class="space-y-4">
          <h3 class="font-heading text-navy text-lg md:text-xl font-bold tracking-tight">Community</h3>
          <p>
            Prince volunteered with the Elizabeth Fry Society in Calgary, assisting courthouse visitors with navigating processes. He has also contributed his time through the Court of King's Bench Amicus Program, supporting self-represented litigants in docket court, and as a mentor with the Calgary Region Immigrant Employment Council, helping newcomers establish themselves in Canada.
          </p>
        </section>

        <section class="space-y-4">
          <h3 class="font-heading text-navy text-lg md:text-xl font-bold tracking-tight">Outside the Office</h3>
          <p>
            When Prince is not working, he enjoys exploring new tech gadgets or listening to Hillsong worship music. Global politics and football are guaranteed conversation starters. He values time in nature and spends his downtime hiking, gaming, and travelling.
          </p>
        </section>

        <div class="flex flex-col sm:flex-row gap-4 justify-center pt-4 text-center">
        <a
          href="/contact"
          class="inline-block bg-gold text-navy font-bold px-8 py-3 rounded hover:bg-[#d4aa5a] transition-colors text-sm uppercase tracking-wider"
        >
          Schedule a Consultation
        </a>
        <a
          href="tel:+18254610107"
          class="inline-block border-2 border-navy text-navy font-bold px-8 py-3 rounded hover:bg-navy/5 transition-colors text-sm uppercase tracking-wider"
        >
          &#9742; (825) 461-0107
        </a>
      </div>
      </div>
    </div>
  </section>

  <!-- Section 3: What to Expect -->
  <section class="bg-light-bg pt-10 md:pt-14 pb-20 md:pb-28 px-6">
    <div class="max-w-5xl mx-auto">
      <h2 class="font-heading text-navy text-2xl md:text-3xl font-bold text-center mb-14 tracking-tight">
        What to Expect
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
        <div class="space-y-4">
          <div class="w-10 h-0.5 bg-gold"></div>
          <h3 class="font-heading text-navy text-lg font-bold">We Work Together</h3>
          <p class="text-body-text leading-relaxed">
            Your legal matter is a partnership, not a handoff. Prince works directly with every client to understand their situation, explore options together, and build a strategy that reflects their priorities.
          </p>
        </div>
        <div class="space-y-4">
          <div class="w-10 h-0.5 bg-gold"></div>
          <h3 class="font-heading text-navy text-lg font-bold">Calm, Clear, and Honest</h3>
          <p class="text-body-text leading-relaxed">
            Legal issues can be stressful. Prince creates a space where clients feel comfortable enough to ask questions and speak openly. You will always know where your matter stands and what your options are.
          </p>
        </div>
        <div class="space-y-4">
          <div class="w-10 h-0.5 bg-gold"></div>
          <h3 class="font-heading text-navy text-lg font-bold">Capable Hands, Full Attention</h3>
          <p class="text-body-text leading-relaxed">
            Every file receives thorough preparation and genuine care. Prince pursues negotiated outcomes where they serve your interests and litigates with conviction when they do not.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
