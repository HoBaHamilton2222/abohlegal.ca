---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { siteConfig } from '../data/siteConfig';
import courthouseExterior from '../assets/stock/courthouse-exterior.jpg';

const formAction = siteConfig.formspreeEndpoint || '#';

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.abohlegal.ca/" },
    { "@type": "ListItem", "position": 2, "name": "Contact" }
  ]
});
---

<BaseLayout
  title="Contact Us | ABOH LEGAL | St. Paul, Alberta"
  description="Contact ABOH LEGAL in St. Paul, Alberta. Call (825) 461-0107 or send us a message. Legal Aid certificates accepted."
>
  <script slot="head" type="application/ld+json" set:html={breadcrumbSchema} />

  <!-- Hero: Landscape image with overlay -->
  <section class="relative min-h-[350px] md:min-h-[400px] flex items-center justify-center overflow-hidden">
    <Image
      src={courthouseExterior}
      alt="Courthouse exterior"
      class="absolute inset-0 w-full h-full object-cover object-center"
      aria-hidden="true"
      widths={[640, 960, 1920]}
      sizes="100vw"
      format="webp"
      quality={80}
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-navy/80"></div>
    <div class="relative text-center px-6 py-16 md:py-24 max-w-3xl mx-auto">
      <h1 class="font-heading text-white text-4xl md:text-5xl lg:text-6xl font-bold mb-4">Contact Us</h1>
      <p class="text-white/70 text-lg md:text-xl leading-relaxed">
        Get in touch. We would love to help you with your legal needs.
      </p>
    </div>
  </section>

  <!-- Intro + Contact Info Block -->
  <section class="bg-white py-16 md:py-20 px-6">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-body-text text-base md:text-lg leading-relaxed mb-6">
        At ABOH LEGAL, we believe in a straightforward approach. We take the time to understand your situation, explain your options in plain language, and only move forward once we have agreed on a clear plan together. The last thing we want is for you to feel uncertain about the process or the cost.
      </p>
      <p class="text-body-text text-base md:text-lg leading-relaxed mb-10">
        Whether you are dealing with a family matter, planning your estate, navigating an employment issue, or need guidance on immigration, we are here to help make the process as stress-free as possible.
      </p>

      <!-- Contact Details -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-4xl mx-auto">
        <div class="bg-[#f9f8f6] rounded-lg p-6">
          <p class="text-navy font-bold text-sm uppercase tracking-wider mb-2">Phone</p>
          <a href={siteConfig.phoneHref} class="text-gold font-bold hover:underline">{siteConfig.phone}</a>
        </div>
        <div class="bg-[#f9f8f6] rounded-lg p-6">
          <p class="text-navy font-bold text-sm uppercase tracking-wider mb-2">Email</p>
          <a href={`mailto:${siteConfig.email}`} class="text-gold font-bold hover:underline text-sm">{siteConfig.email}</a>
        </div>
        <div class="bg-[#f9f8f6] rounded-lg p-6">
          <p class="text-navy font-bold text-sm uppercase tracking-wider mb-2">Address</p>
          <p class="text-body-text text-sm">{siteConfig.address.full}</p>
        </div>
        <div class="bg-[#f9f8f6] rounded-lg p-6">
          <p class="text-navy font-bold text-sm uppercase tracking-wider mb-2">Office Hours</p>
          <p class="text-body-text text-sm">{siteConfig.hours}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Book a time directly -->
  <section class="bg-white pb-16 md:pb-20 px-6">
    <div class="max-w-2xl mx-auto text-center border-t border-gray-200 pt-12">
      <h2 class="font-heading text-navy text-2xl md:text-3xl font-bold mb-4">Book a Time Directly</h2>
      <p class="text-body-text text-base md:text-lg leading-relaxed mb-8">
        Choose a time that works for you and see live availability. Appointments are available by phone, by video, or at our office.
      </p>
      <a
        href={siteConfig.bookingUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-navy text-white font-bold px-8 py-3 rounded hover:bg-opacity-90 transition-colors text-sm md:text-base uppercase tracking-wider"
      >
        Book an Appointment
      </a>
      <p class="text-body-text/70 text-sm mt-4">
        No account needed. Select &ldquo;Continue as guest&rdquo;.
      </p>
    </div>
  </section>

  <!-- Schedule a Consultation + Form -->
  <section class="bg-[#f9f8f6] py-16 md:py-20 px-6">
    <div class="max-w-2xl mx-auto">
      <div class="text-center mb-10">
        <h2 class="font-heading text-navy text-2xl md:text-3xl font-bold mb-4">Or Send Us a Message</h2>
        <p class="text-body-text text-base md:text-lg leading-relaxed">
          Prefer to write first? Tell us a little about your situation and we will get back to you promptly. We want to make things as stress-free as possible.
        </p>
      </div>

      <!-- Success State -->
      <div id="form-success" class="hidden text-center py-12 bg-white rounded-lg">
        <svg class="mx-auto mb-6 w-16 h-16 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <p class="text-navy text-lg md:text-xl font-bold mb-2">Thank you!</p>
        <p class="text-body-text text-base">We have received your message and will respond within one business day.</p>
      </div>

      <!-- Error State -->
      <div id="form-error" class="hidden text-center py-8 bg-red-50 rounded-lg px-6 mb-6">
        <p class="text-red-700 text-base">
          Something went wrong. Please try calling us at <a href="tel:+18254610107" class="font-bold underline">(825) 461-0107</a> or emailing <a href="mailto:info@abohlegal.ca" class="font-bold underline">info@abohlegal.ca</a> directly.
        </p>
      </div>

      <!-- Form -->
      <form
        id="contact-form"
        action={formAction}
        method="POST"
        novalidate
        class="bg-white rounded-lg p-8 md:p-10 space-y-5"
      >
        <!-- Honeypot -->
        <input type="text" name="_gotcha" style="display:none" />

        <!-- Name -->
        <div>
          <label for="name" class="block text-navy font-bold text-sm mb-1">Name <span class="text-red-600">*</span></label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="w-full border border-gray-300 rounded px-4 py-3 text-body-text focus:outline-none focus:border-navy focus:ring-1 focus:ring-navy transition-colors"
          />
          <p class="text-red-600 text-sm mt-1 hidden" data-error="name">Please enter your name.</p>
        </div>

        <!-- Email -->
        <div>
          <label for="email" class="block text-navy font-bold text-sm mb-1">Email Address <span class="text-red-600">*</span></label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full border border-gray-300 rounded px-4 py-3 text-body-text focus:outline-none focus:border-navy focus:ring-1 focus:ring-navy transition-colors"
          />
          <p class="text-red-600 text-sm mt-1 hidden" data-error="email">Please enter a valid email address.</p>
        </div>

        <!-- Location -->
        <div>
          <label for="location" class="block text-navy font-bold text-sm mb-1">Where are you located? <span class="text-red-600">*</span></label>
          <input
            type="text"
            id="location"
            name="location"
            required
            class="w-full border border-gray-300 rounded px-4 py-3 text-body-text focus:outline-none focus:border-navy focus:ring-1 focus:ring-navy transition-colors"
          />
          <p class="text-red-600 text-sm mt-1 hidden" data-error="location">Please enter your location.</p>
        </div>

        <!-- Subject -->
        <div>
          <label for="subject" class="block text-navy font-bold text-sm mb-1">Subject <span class="text-red-600">*</span></label>
          <input
            type="text"
            id="subject"
            name="subject"
            required
            class="w-full border border-gray-300 rounded px-4 py-3 text-body-text focus:outline-none focus:border-navy focus:ring-1 focus:ring-navy transition-colors"
          />
          <p class="text-red-600 text-sm mt-1 hidden" data-error="subject">Please enter a subject.</p>
        </div>

        <!-- Message -->
        <div>
          <label for="message" class="block text-navy font-bold text-sm mb-1">Message <span class="text-red-600">*</span></label>
          <textarea
            id="message"
            name="message"
            rows="6"
            required
            class="w-full border border-gray-300 rounded px-4 py-3 text-body-text focus:outline-none focus:border-navy focus:ring-1 focus:ring-navy transition-colors resize-y"
          ></textarea>
          <p class="text-red-600 text-sm mt-1 hidden" data-error="message">Please enter your message.</p>
        </div>

        <!-- Disclaimer -->
        <p class="text-muted-text text-xs leading-relaxed">
          Please do not leave any confidential information in this form. No solicitor-client relationship is formed until we have been formally retained.
        </p>

        <!-- Submit -->
        <button
          type="submit"
          id="submit-btn"
          class="w-full bg-gold text-navy font-bold px-8 py-3 rounded hover:bg-[#d4aa5a] transition-colors text-sm uppercase tracking-wider disabled:opacity-50 disabled:cursor-not-allowed"
        >
          Submit
        </button>
      </form>
    </div>
  </section>


</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const successDiv = document.getElementById('form-success');
    const errorDiv = document.getElementById('form-error');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

    if (!form || !successDiv || !errorDiv || !submitBtn) return;

    function showError(fieldId: string) {
      const el = document.querySelector(`[data-error="${fieldId}"]`);
      if (el) el.classList.remove('hidden');
    }

    function clearErrors() {
      document.querySelectorAll('[data-error]').forEach((el) => el.classList.add('hidden'));
    }

    function validateEmail(email: string): boolean {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    }

    function validate(): boolean {
      clearErrors();
      let valid = true;

      const name = (document.getElementById('name') as HTMLInputElement).value.trim();
      const email = (document.getElementById('email') as HTMLInputElement).value.trim();
      const location = (document.getElementById('location') as HTMLInputElement).value.trim();
      const subject = (document.getElementById('subject') as HTMLInputElement).value.trim();
      const message = (document.getElementById('message') as HTMLTextAreaElement).value.trim();

      if (!name) { showError('name'); valid = false; }
      if (!email || !validateEmail(email)) { showError('email'); valid = false; }
      if (!location) { showError('location'); valid = false; }
      if (!subject) { showError('subject'); valid = false; }
      if (!message) { showError('message'); valid = false; }

      return valid;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!validate()) return;

      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';
      errorDiv.classList.add('hidden');

      try {
        const formData = new FormData(form);
        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: { Accept: 'application/json' },
        });

        if (response.ok) {
          form.classList.add('hidden');
          errorDiv.classList.add('hidden');
          successDiv.classList.remove('hidden');
        } else {
          errorDiv.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.textContent = 'Submit';
        }
      } catch {
        errorDiv.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Submit';
      }
    });
  });
</script>
