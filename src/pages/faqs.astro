---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import CTABanner from '../components/CTABanner.astro';
import { faqsByCategory } from '../data/faqs';
import ladyJustice from '../assets/stock/lady-justice.jpg';

// Build FAQPage schema from all FAQs
const allFaqs = Object.values(faqsByCategory).flat();
const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": allFaqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
});

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.abohlegal.ca/" },
    { "@type": "ListItem", "position": 2, "name": "FAQs" }
  ]
});

const categoryTitles: Record<string, string> = {
  'family-law': 'Family Law',
  'wills-estates': 'Wills & Estates',
  'estate-litigation': 'Estate Litigation',
  'employment-law': 'Employment Law',
  'business-commercial': 'Business & Commercial Law',
  'civil-litigation': 'Civil Litigation',
  'immigration': 'Immigration',
};
---

<BaseLayout
  title="Frequently Asked Questions | ABOH LEGAL"
  description="Common questions about family law, wills, estates, employment law, and more. Answers from ABOH LEGAL in St. Paul, Alberta."
>
  <script slot="head" type="application/ld+json" set:html={faqSchema} />
  <script slot="head" type="application/ld+json" set:html={breadcrumbSchema} />

  <Hero title="Frequently Asked Questions" backgroundImage={ladyJustice} />

  <section class="bg-white py-16 md:py-20 px-6">
    <div class="max-w-3xl mx-auto space-y-14">
      {Object.entries(faqsByCategory).map(([slug, faqs]) => (
        <div>
          <h2 class="font-heading text-navy text-xl md:text-2xl font-bold mb-6 pl-4 border-l-4 border-gold">
            {categoryTitles[slug] || slug}
          </h2>
          <div>
            {faqs.map((faq) => (
              <FAQAccordion question={faq.question} answer={faq.answer} />
            ))}
          </div>
        </div>
      ))}
      <p class="text-body-text text-sm">
        These answers are general information about the law, not legal advice. The law changes and every situation is different. Reading this page or contacting us does not make you our client.
      </p>
    </div>
  </section>

  <CTABanner
    heading="Still have questions?"
    body="Book a consultation to talk about your situation."
    buttonText="Contact Us"
    buttonHref="/contact"
  />
</BaseLayout>
