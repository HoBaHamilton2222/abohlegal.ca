---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABanner from '../../components/CTABanner.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const now = new Date();
  const posts = await getCollection('blog', ({ data }) => {
    if (data.draft) return false;
    const effective = data.publishDate ?? data.date;
    return effective.valueOf() <= now.valueOf();
  });
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Show the date the post actually went live, and the date it was last reviewed.
const publishedOn = post.data.publishDate ?? post.data.date;
const updatedOn = post.data.updated;
const fmt = (d: Date) =>
  d.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

const formattedDate = fmt(publishedOn);
const formattedUpdated = updatedOn ? fmt(updatedOn) : null;
const asOfDate = formattedUpdated ?? formattedDate;

const isoDate = publishedOn.toISOString().split('T')[0];
const isoUpdated = updatedOn ? updatedOn.toISOString().split('T')[0] : isoDate;

const articleSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.data.title,
  "description": post.data.excerpt,
  "datePublished": isoDate,
  "dateModified": isoUpdated,
  "author": {
    "@type": "Person",
    "@id": "https://www.abohlegal.ca/about#person",
    "name": "Prince Aboh"
  },
  "publisher": {
    "@id": "https://www.abohlegal.ca/#organization"
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://www.abohlegal.ca/resources/${post.id}`
  }
});

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.abohlegal.ca/" },
    { "@type": "ListItem", "position": 2, "name": "Resources", "item": "https://www.abohlegal.ca/resources" },
    { "@type": "ListItem", "position": 3, "name": post.data.title }
  ]
});
---

<BaseLayout
  title={`${post.data.title} | ABOH LEGAL`}
  description={post.data.excerpt}
>
  <script slot="head" type="application/ld+json" set:html={articleSchema} />
  <script slot="head" type="application/ld+json" set:html={breadcrumbSchema} />

  <section class="py-16 md:py-20 px-6">
    <div class="max-w-3xl mx-auto">
      <!-- Category Tag -->
      <span class="inline-block bg-gold/10 text-gold text-xs font-bold uppercase tracking-wider px-3 py-1 rounded mb-4">
        {post.data.category}
      </span>

      <!-- Title -->
      <h1 class="font-heading text-navy text-3xl md:text-4xl lg:text-5xl font-bold mb-4">
        {post.data.title}
      </h1>

      <!-- Meta -->
      <p class="text-muted-text text-sm mb-10">
        <time datetime={isoDate}>{formattedDate}</time>
        {formattedUpdated && (<> &middot; Updated <time datetime={isoUpdated}>{formattedUpdated}</time></>)}
        &middot; {post.data.author}<span class="text-muted-text/70">, LL.B., B.L.</span>
      </p>

      <!-- Article Content -->
      <article class="prose prose-lg max-w-none prose-headings:text-navy prose-a:text-gold">
        <Content />
      </article>

      <!-- General information notice -->
      <p class="mt-12 border-t border-gray-200 pt-6 text-body-text text-sm">
        This article is general information about the law as of {asOfDate}. It is not legal advice. The law changes and every situation is different, so speak with a lawyer about your own facts. Reading this article or contacting us does not make you our client.
      </p>
    </div>
  </section>

  <CTABanner
    heading="Need Legal Advice?"
    body="If you have questions about your legal matter, reach out. We'd be glad to help."
    buttonText="Contact Us"
    buttonHref="/contact"
  />
</BaseLayout>
