{
  "redirects": [
    { "source": "/services/real-estate", "destination": "/services", "permanent": true },
    { "source": "/services/personal-injury", "destination": "/services", "permanent": true },
    { "source": "/resources/alberta-minor-injury-regulation-cap-explained", "destination": "/resources", "permanent": true },
    { "source": "/resources/what-to-do-after-motor-vehicle-collision-alberta", "destination": "/resources", "permanent": true },
    {
      "source": "/book",
      "destination": "https://calendly.com/prince-abohlegal/initial-consultation",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ]
}
